<Window x:Class="OneClickConverter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="One Click Converter" Height="760" Width="1040"
        Icon="Assets/converter.ico"
        MinHeight="650" MinWidth="820" WindowStartupLocation="CenterScreen"
        Background="{StaticResource Canvas}" Foreground="{StaticResource Ink}" AllowDrop="True"
        DragOver="Window_DragOver" Drop="Window_Drop" Loaded="MainWindow_Loaded" Closing="MainWindow_Closing" Closed="MainWindow_Closed">
    <Window.Resources>
        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource Accent}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderThickness" Value="0" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentHover}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentPressed}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="FormatCombo" TargetType="ComboBox">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="MinWidth" Value="150" />
            <Setter Property="Background" Value="White" />
        </Style>
    </Window.Resources>
    <Grid Margin="36,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="24" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="18" />
            <RowDefinition Height="*" />
            <RowDefinition Height="20" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="18" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" LastChildFill="False">
            <Border Width="42" Height="42" CornerRadius="13" Background="#FBE8D8" DockPanel.Dock="Left" Margin="0,0,13,0">
                <Canvas Width="26" Height="26" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Path Data="M 19,10 A 7,7 0 0 0 6,7" Stroke="{StaticResource Accent}" StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    <Polygon Points="5,3 11,5 6,10" Fill="{StaticResource Accent}" />
                    <Path Data="M 7,16 A 7,7 0 0 0 20,19" Stroke="{StaticResource Accent}" StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    <Polygon Points="21,23 15,21 20,16" Fill="{StaticResource Accent}" />
                </Canvas>
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="One Click Converter" FontSize="19" FontWeight="SemiBold" />
                <TextBlock Text="Private, offline file conversion for Windows" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,3,0,0" />
            </StackPanel>
            <Border DockPanel.Dock="Right" Background="#E9F1E8" CornerRadius="12" Padding="11,7" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="7" Height="7" Fill="#5D9C65" VerticalAlignment="Center" Margin="0,0,7,0" />
                    <TextBlock Text="Files stay on this PC" FontSize="11" Foreground="#426C48" />
                </StackPanel>
            </Border>
        </DockPanel>

        <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="18" Padding="20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Grid.ColumnSpan="2" BorderBrush="#E8C9AE" BorderThickness="1.5" CornerRadius="13" Background="#FFFCF9"
                        AllowDrop="True" DragOver="DropZone_DragOver" Drop="DropZone_Drop" Padding="18">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border Width="46" Height="46" CornerRadius="14" Background="#FBE8D8" HorizontalAlignment="Center" Margin="0,0,0,10">
                            <TextBlock Text="＋" FontSize="28" Foreground="{StaticResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-4,0,0" />
                        </Border>
                        <TextBlock Text="Drop files here to get started" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <TextBlock Text="Choose an output format, then convert. Everything runs locally." FontSize="12" Foreground="{StaticResource Muted}" Margin="0,6,0,0" HorizontalAlignment="Center" />
                        <Button Content="Browse files" Click="Browse_Click" Style="{StaticResource PrimaryButton}" Margin="0,14,0,0" Padding="19,9" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <DockPanel Grid.Row="4" LastChildFill="False">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                <TextBlock Text="Files" FontSize="15" FontWeight="SemiBold" />
                <Border Background="#ECEAE4" CornerRadius="9" Padding="8,3" Margin="9,0,0,0">
                    <TextBlock x:Name="FileCountText" Text="0" FontSize="11" Foreground="{StaticResource Muted}" />
                </Border>
            </StackPanel>
            <Button Content="Clear all" DockPanel.Dock="Right" Click="Clear_Click" Background="Transparent" Foreground="{StaticResource Muted}" Padding="8,5" />
        </DockPanel>

        <Border Grid.Row="4" Margin="0,38,0,0" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="14">
            <Grid>
                <ListView x:Name="FilesList" ItemsSource="{Binding Files}" BorderThickness="0" Background="Transparent" Padding="7">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Padding" Value="7,9" />
                            <Setter Property="BorderThickness" Value="0,0,0,1" />
                            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="42" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="90" />
                                </Grid.ColumnDefinitions>
                                <Border Width="34" Height="38" CornerRadius="7" Background="#F3F1EA" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ExtensionLabel}" FontSize="9" FontWeight="Bold" Foreground="#78796F" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding SizeLabel}" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,3,0,0" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding Status}" FontSize="11" Foreground="{StaticResource Muted}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                <Button Grid.Column="3" Content="Remove" Tag="{Binding}" Click="Remove_Click" Background="Transparent" Foreground="{StaticResource Muted}" Padding="8,4" HorizontalAlignment="Right" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <TextBlock x:Name="EmptyHint" Text="Your selected files will appear here" FontSize="13" Foreground="#A1A198" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />
            </Grid>
        </Border>

        <Border Grid.Row="6" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="14" Padding="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,22,0">
                    <TextBlock Text="Convert to" FontSize="11" Foreground="{StaticResource Muted}" />
                    <ComboBox x:Name="FormatCombo" Style="{StaticResource FormatCombo}" Margin="0,6,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,15,0">
                    <TextBlock Text="Save to" FontSize="11" Foreground="{StaticResource Muted}" />
                    <DockPanel Margin="0,6,0,0">
                        <Button Content="Choose folder" DockPanel.Dock="Right" Click="ChooseFolder_Click" Style="{StaticResource SecondaryButton}" Padding="12,8" />
                        <TextBox x:Name="OutputFolderText" IsReadOnly="True" BorderThickness="0" Background="Transparent" FontFamily="Segoe UI" FontSize="12" Foreground="{StaticResource Ink}" VerticalContentAlignment="Center" />
                    </DockPanel>
                </StackPanel>
                <Button x:Name="ConvertButton" Grid.Column="2" Content="Convert files  →" Click="Convert_Click" Style="{StaticResource PrimaryButton}" Padding="20,13" MinWidth="150" VerticalAlignment="Bottom" />
            </Grid>
        </Border>

        <DockPanel Grid.Row="8" LastChildFill="False">
            <TextBlock x:Name="StatusText" Text="Ready when you are." FontSize="11" Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
            <Button x:Name="OpenFolderButton" Content="Open output folder ↗" Click="OpenFolder_Click" DockPanel.Dock="Right" Background="Transparent" Foreground="{StaticResource Muted}" Padding="7,4" IsEnabled="False" />
        </DockPanel>

    </Grid>
</Window>
