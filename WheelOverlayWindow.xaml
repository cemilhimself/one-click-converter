<Window x:Class="OneClickConverter.WheelOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="480" Height="480" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        ResizeMode="NoResize" AllowDrop="True" DragOver="Wheel_DragOver" Drop="Wheel_Drop">
    <Grid>
        <Ellipse Width="424" Height="424" Fill="#F5FFFFFF" Stroke="#26FFFFFF" StrokeThickness="1"
                 HorizontalAlignment="Center" VerticalAlignment="Center" />
        <Ellipse Width="300" Height="300" Fill="Transparent" Stroke="#28E78A45" StrokeThickness="1"
                 HorizontalAlignment="Center" VerticalAlignment="Center" />
        <Canvas x:Name="WheelCanvas" Width="480" Height="480" HorizontalAlignment="Center" VerticalAlignment="Center" />
        <Border Width="112" Height="112" CornerRadius="56" Background="#FF252822" BorderBrush="#FFE78A45"
                BorderThickness="3" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="DROP TO" FontSize="10" FontWeight="Bold" Foreground="#FFD9DAD4" HorizontalAlignment="Center" />
                <TextBlock x:Name="SelectedFormatText" Text="FORMAT" FontSize="15" FontWeight="Bold" Foreground="White"
                           HorizontalAlignment="Center" Margin="0,5,0,0" />
            </StackPanel>
        </Border>
        <Border VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="12,0,12,11" Background="#E9222520"
                CornerRadius="12" Padding="12,7" MaxWidth="456" IsHitTestVisible="False">
            <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="SAVE TO" Foreground="#FFFFBE8F" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" />
                <TextBlock x:Name="OutputLocationText" Foreground="White" FontSize="11" TextTrimming="CharacterEllipsis"
                           MaxWidth="420" HorizontalAlignment="Center" Margin="0,2,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
