<Window x:Class="OneClickConverter.WheelOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="480" Height="480" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        ResizeMode="NoResize" AllowDrop="True" DragOver="Wheel_DragOver" Drop="Wheel_Drop">
    <Window.Resources>
        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#604C52" BlurRadius="12" ShadowDepth="3" Opacity="0.12" />
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Ellipse Width="432" Height="432" HorizontalAlignment="Center" VerticalAlignment="Center" Stroke="#BFFFFFFF"
                 StrokeThickness="1.5" Fill="#DDF6F3F8">
            <Ellipse.Effect><DropShadowEffect Color="#5A5260" BlurRadius="36" ShadowDepth="10" Opacity="0.22" /></Ellipse.Effect>
        </Ellipse>
        <Ellipse Width="382" Height="382" HorizontalAlignment="Center" VerticalAlignment="Center"
                 Stroke="#A6FFFFFF" StrokeThickness="1">
            <Ellipse.Fill>
                <RadialGradientBrush GradientOrigin="0.28,0.18">
                    <GradientStop Color="#E8FFFFFF" Offset="0" />
                    <GradientStop Color="#BFFFFFFF" Offset="0.72" />
                    <GradientStop Color="#B7F4EAF7" Offset="1" />
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>
        <Ellipse Width="298" Height="298" HorizontalAlignment="Center" VerticalAlignment="Center"
                 Fill="Transparent" Stroke="#48D883AD" StrokeThickness="1.2" />
        <Ellipse Width="190" Height="190" HorizontalAlignment="Center" VerticalAlignment="Center"
                 Fill="#22E9A16E" IsHitTestVisible="False">
            <Ellipse.Effect><BlurEffect Radius="40" /></Ellipse.Effect>
        </Ellipse>
        <Canvas x:Name="WheelCanvas" Width="480" Height="480" HorizontalAlignment="Center" VerticalAlignment="Center" />

        <Border Width="118" Height="118" CornerRadius="59" BorderBrush="#E6FFFFFF" BorderThickness="1.5"
                HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
            <Border.Background>
                <RadialGradientBrush GradientOrigin="0.3,0.22">
                    <GradientStop Color="#FEFFFFFF" Offset="0" />
                    <GradientStop Color="#EEF6F0F6" Offset="1" />
                </RadialGradientBrush>
            </Border.Background>
            <Border.Effect><DropShadowEffect Color="#6A515F" BlurRadius="22" ShadowDepth="5" Opacity="0.17" /></Border.Effect>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="DROP TO" FontSize="9" FontWeight="Bold" Foreground="#9D7C8D" HorizontalAlignment="Center" />
                <TextBlock x:Name="SelectedFormatText" Text="FORMAT" FontSize="16" FontWeight="Bold" Foreground="#3B3340"
                           HorizontalAlignment="Center" Margin="0,5,0,0" />
            </StackPanel>
        </Border>

        <Border VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="12,0,12,10" Background="#E9FFFFFF"
                BorderBrush="#CFFFFFFF" BorderThickness="1" CornerRadius="15" Padding="14,8" MaxWidth="456" IsHitTestVisible="False">
            <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="SAVE LOCATION" Foreground="#A36D58" FontSize="8" FontWeight="Bold" HorizontalAlignment="Center" />
                <TextBlock x:Name="OutputLocationText" Foreground="#514957" FontSize="10" TextTrimming="CharacterEllipsis"
                           MaxWidth="420" HorizontalAlignment="Center" Margin="0,3,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
